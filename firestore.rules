rules_version = '2';
// HK / US Portfolio — content-protecting security rules.
//
// WHY THIS EXISTS (read wiki/reliability-risks.md + wiki/incidents.md first):
// The old rules allowed the authenticated owner to replace the WHOLE document
// (doc.set()). A stale browser tab is the authenticated owner, so it could wipe
// closedTrades / snapshots / positions written after it loaded. That is the root
// cause of every data-loss incident (Jun 4/5, May 28/29, Jun 11, Jun 16-24, the
// Jun 24 WuXi sale + Xiaomi loss of Jun 28). Client-side guards can't fix it
// because the offending tab runs OLD code. These rules run on Google's servers
// and apply regardless of client version. The cron + admin SDK bypass rules, so
// the daily update and repair scripts are unaffected; only the browser client is
// constrained — which is exactly where the bug originates.
service cloud.firestore {
  match /databases/{database}/documents {

    function owner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // res = existing doc, req = incoming doc.
    //
    // closedTrades & snapshots may NEVER shrink (no browser path legitimately
    // removes one).
    //
    // positions may grow, stay, or shrink -- but every departure must be
    // EXPLAINED, by one of exactly two receipts:
    //   * a sale        -> closedTrades grew, or
    //   * a manual delete -> positionDeletions grew by at least as many entries
    //                        as positions lost.
    // positionDeletions is itself append-only, so a client cannot mint the
    // receipt by rewinding the log.
    //
    // WHY THE RECEIPT (2026-09-08, 1138.HK): the previous version allowed a
    // shrink by EXACTLY 1 with no receipt at all, to leave room for a manual
    // single delete. That unconditional allowance was the last remaining
    // data-loss hole (it was recorded as the "Residual" in wiki/security-rules.md)
    // and it has the exact shape of a stale tab reverting a freshly added
    // position: positions 15 -> 14, no new trade. Requiring the delete to carry
    // a receipt keeps the legitimate action working and closes the hole.
    //
    // SECOND EFFECT, the important one: positionDeletions is a field OLD client
    // code does not know about. Both HTML clients build the outgoing document
    // from an explicit field whitelist, so a tab running old cached JS DROPS the
    // field on its full-document set() -> reqDel (0) < resDel -> the whole write
    // is rejected by the append-only clause. The stale/old-code tab is precisely
    // the client every prior client-side guard could never reach (it never loads
    // the guard). Once this log holds one entry, that client is locked out at the
    // server, whatever JS it is running.
    function safePortfolioUpdate() {
      let res = resource.data;
      let req = request.resource.data;
      let resClosed = res.get('closedTrades', []).size();
      let reqClosed = req.get('closedTrades', []).size();
      let resDel = res.get('positionDeletions', []).size();
      let reqDel = req.get('positionDeletions', []).size();
      let posDrop = res.get('positions', []).size() - req.get('positions', []).size();
      return reqClosed >= resClosed
          && req.get('snapshots', []).size() >= res.get('snapshots', []).size()
          && reqDel >= resDel
          && (
               posDrop <= 0                    // grew or unchanged
               || reqClosed > resClosed        // a real sale explains the departure
               || posDrop <= reqDel - resDel   // a manual delete receipt explains it
             );
    }

    match /portfolios/{userId} {
      allow read: if owner(userId)
                  || (request.auth != null
                      && request.auth.token.email in resource.data.allowedViewers);
      allow create: if owner(userId);
      allow update: if owner(userId) && safePortfolioUpdate();
      // whole-document delete: default deny
    }

    match /us-portfolios/{userId} {
      allow read: if owner(userId)
                  || (request.auth != null
                      && request.auth.token.email in resource.data.allowedViewers);
      allow create: if owner(userId);
      allow update: if owner(userId) && safePortfolioUpdate();
    }

    match /viewerInvites/{inviteId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null
                          && request.auth.token.email == resource.data.inviteeEmail;
    }
  }
}
